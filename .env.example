# Copy to .env on the host; never commit actual credentials.
PLANNER_PORT=8000
MESHWARS_REFRESH_SECONDS=1800
MESHWARS_SCORES_URL=https://meshwars.com/scores
MAX_CONCURRENT_SEARCHES=2
OSRM_URL=https://router.project-osrm.org
OSRM_WORKERS=4
OSRM_REQUEST_INTERVAL=1
PHOTON_URL=https://photon.komoot.io
# Optional approved FreqMapper integration:
FREQMAPPER_PARTNER_TOKEN=
FREQMAPPER_REGION=SLC
# Only required for compose.https.yaml:
PLANNER_DOMAIN=planner.example.com
PLANNER_USER=planner
# Use a Caddy bcrypt hash. In .env, single-quote it so $ signs stay literal.
PLANNER_PASSWORD_HASH=

MESHWARS_PLACES_URL=https://meshwars.com/api/places
